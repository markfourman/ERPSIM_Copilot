# Copy to .env and fill in (never share or commit .env)

# Chat: free key from Google AI Studio (https://aistudio.google.com) -> Get API key
GEMINI_API_KEY=

# The game's data feed and your ERPsim login
ERPSIM_ODATA_URL=https://<server>/odata/<client>
ERPSIM_USER=
ERPSIM_PASSWORD=

# Optional
# COPILOT_MODEL=gemini-3.5-flash-lite
# COPILOT_PROVIDER=claude        (then also set ANTHROPIC_API_KEY and pip install anthropic)
